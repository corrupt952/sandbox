<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately nothing but the sandbox itself: no file, network, or
	     temporary-exception entitlements. The helper is supposed to reach the
	     workspace only through descriptors the host hands it, so anything it can
	     still open by path is a finding. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
